
#include <Wire.h>
#include <MPU6500_WE.h>

#define MPU_ADDR 0x68

MPU6500_WE imu = MPU6500_WE(MPU_ADDR);

void setup()
{
    Serial.begin(115200);
    Wire.begin();

    if (!imu.init())
    {
        Serial.println("MPU6500 NOT FOUND!");
        while (1);
    }

    Serial.println("MPU6500 CONNECTED");

    imu.setAccRange(MPU6500_ACC_RANGE_2G);
    imu.setGyrRange(MPU6500_GYRO_RANGE_250);

    Serial.println("Starting sensor readings...");
}

void loop()
{
    xyzFloat acc = imu.getGValues();
    xyzFloat gyro = imu.getGyrValues();

    float temp = imu.getTemperature();

    Serial.print("AX = ");
    Serial.print(acc.x, 3);

    Serial.print(" | AY = ");
    Serial.print(acc.y, 3);

    Serial.print(" | AZ = ");
    Serial.print(acc.z, 3);

    Serial.print(" | GX = ");
    Serial.print(gyro.x, 3);

    Serial.print(" | GY = ");
    Serial.print(gyro.y, 3);

    Serial.print(" | GZ = ");
    Serial.print(gyro.z, 3);

    Serial.print(" | TEMP = ");
    Serial.println(temp, 2);

    delay(100);
}
