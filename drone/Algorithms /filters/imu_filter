    }
    else{
      cax=0;// i wanted c reset to 0 , i wanted only c affect the % share of data when the reading is real ,when it is continusly increasing or decreasing
    }

    // when you dont understand code >>debugging

    if (((fax-anoise<=ax) && (ax<=ax+anoise))){
      fax=fax;//no chainge
      c=0;
    }
    else{
      c++;
      if (c>5){
        c=5;
        fax=(100-(c*10))*fax + (c*10)*ax;

      }

    }*/



    // ---------- AX ----------
    if (!((fax - anoise <= ax) && (ax <= fax + anoise))) {
        cax++;
        if (cax > 5) cax = 5;

        fax = ((100 - cax * 10) * fax + (cax * 10) * ax) / 100.0;
    }
    else {
        cax = 0;
    }

    // ---------- AY ----------
    if (!((fay - anoise <= ay) && (ay <= fay + anoise))) {
        cay++;
        if (cay > 5) cay = 5;

        fay = ((100 - cay * 10) * fay + (cay * 10) * ay) / 100.0;
    }
    else {
        cay = 0;
    }

    // ---------- AZ ----------
    if (!((faz - anoise <= az) && (az <= faz + anoise))) {
        caz++;
        if (caz > 5) caz = 5;

        faz = ((100 - caz * 10) * faz + (caz * 10) * az) / 100.0;
    }
    else {
        caz = 0;
    }

    // ---------- GX ----------
    if (!((fgx - gnoise <= gx) && (gx <= fgx + gnoise))) {
        cgx++;
        if (cgx > 5) cgx = 5;

        fgx = ((100 - cgx * 10) * fgx + (cgx * 10) * gx) / 100.0;
    }
    else {
        cgx = 0;
    }

    // ---------- GY ----------
    if (!((fgy - gnoise <= gy) && (gy <= fgy + gnoise))) {
        cgy++;
        if (cgy > 5) cgy = 5;

        fgy = ((100 - cgy * 10) * fgy + (cgy * 10) * gy) / 100.0;
    }
    else {
        cgy = 0;
    }

    // ---------- GZ ----------
    if (!((fgz - gnoise <= gz) && (gz <= fgz + gnoise))) {
        cgz++;
        if (cgz > 5) cgz = 5;

        fgz = ((100 - cgz * 10) * fgz + (cgz * 10) * gz) / 100.0;
    }
    else {
        cgz = 0;
    }
}



   





















