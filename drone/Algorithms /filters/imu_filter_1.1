//---------------------------------------full all axis code----------------------------------------------

void imuFilter()
{
    // Read accelerometer and gyroscope data
    xyzFloat acc = imu.getGValues();
    xyzFloat gyro = imu.getGyrValues();

    imu_temp = imu.getTemperature();

    ax = acc.x;
    ay = acc.y;
    az = acc.z;

    gx = gyro.x;
    gy = gyro.y;
    gz = gyro.z;


    // ---------- AX FILTERING ----------

    if (!((fax - anoise <= ax) && (ax <= fax + anoise)))
    {
        fax = (10.0 * fax + 80.0 * ax) / 100.0;
    }
    else
    {
        fax = (80.0 * fax + 20.0 * ax) / 100.0;

        if ((-anoise < fax) && (fax < anoise))
        {
            fax = 0.0;
        }
    }


    // ---------- AY FILTERING ----------

    if (!((fay - anoise <= ay) && (ay <= fay + anoise)))
    {
        fay = (10.0 * fay + 80.0 * ay) / 100.0;
    }
    else
    {
        fay = (80.0 * fay + 20.0 * ay) / 100.0;

        if ((-anoise < fay) && (fay < anoise))
        {
            fay = 0.0;
        }
    }


    // ---------- AZ FILTERING ----------

    if (!((faz - anoise <= az) && (az <= faz + anoise)))
    {
        faz = (10.0 * faz + 80.0 * az) / 100.0;
    }
    else
    {
        faz = (80.0 * faz + 20.0 * az) / 100.0;

        if ((-anoise < faz) && (faz < anoise))
        {
            faz = 0.0;
        }
    }


    // ---------- GX FILTERING ----------

    if (!((fgx - gnoise <= gx) && (gx <= fgx + gnoise)))
    {
        fgx = (10.0 * fgx + 80.0 * gx) / 100.0;
    }
    else
    {
        fgx = (80.0 * fgx + 20.0 * gx) / 100.0;

        if ((-gnoise < fgx) && (fgx < gnoise))
        {
            fgx = 0.0;
        }
    }


    // ---------- GY FILTERING ----------

    if (!((fgy - gnoise <= gy) && (gy <= fgy + gnoise)))
    {
        fgy = (10.0 * fgy + 80.0 * gy) / 100.0;
    }
    else
    {
        fgy = (80.0 * fgy + 20.0 * gy) / 100.0;

        if ((-gnoise < fgy) && (fgy < gnoise))
        {
            fgy = 0.0;
        }
    }


    // ---------- GZ FILTERING ----------

    if (!((fgz - gnoise <= gz) && (gz <= fgz + gnoise)))
    {
        fgz = (10.0 * fgz + 80.0 * gz) / 100.0;
    }
    else
    {
        fgz = (80.0 * fgz + 20.0 * gz) / 100.0;

        if ((-gnoise < fgz) && (fgz < gnoise))
        {
            fgz = 0.0;
        }
    }
}
